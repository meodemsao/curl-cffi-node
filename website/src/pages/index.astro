---
import Layout from '../layouts/Layout.astro';

const browsers = [
  { name: 'Chrome 131', family: 'chrome', key: 'chrome131', tag: 'Latest' },
  { name: 'Chrome 124', family: 'chrome', key: 'chrome124' },
  { name: 'Chrome 123', family: 'chrome', key: 'chrome123' },
  { name: 'Chrome 120', family: 'chrome', key: 'chrome120' },
  { name: 'Chrome 119', family: 'chrome', key: 'chrome119' },
  { name: 'Chrome 116', family: 'chrome', key: 'chrome116' },
  { name: 'Chrome 110', family: 'chrome', key: 'chrome110' },
  { name: 'Chrome 107', family: 'chrome', key: 'chrome107' },
  { name: 'Chrome 104', family: 'chrome', key: 'chrome104' },
  { name: 'Chrome 101', family: 'chrome', key: 'chrome101' },
  { name: 'Chrome 100', family: 'chrome', key: 'chrome100' },
  { name: 'Chrome 99', family: 'chrome', key: 'chrome99' },
  { name: 'Chrome 131 Android', family: 'chrome', key: 'chrome131_android', tag: 'Mobile' },
  { name: 'Chrome 99 Android', family: 'chrome', key: 'chrome99_android', tag: 'Mobile' },
  { name: 'Edge 99', family: 'edge', key: 'edge99' },
  { name: 'Edge 101', family: 'edge', key: 'edge101' },
  { name: 'Safari 18.0', family: 'safari', key: 'safari18_0', tag: 'Latest' },
  { name: 'Safari 17.0', family: 'safari', key: 'safari17_0' },
  { name: 'Safari 15.5', family: 'safari', key: 'safari15_5' },
  { name: 'Safari 15.3', family: 'safari', key: 'safari15_3' },
  { name: 'Safari 18.0 iOS', family: 'safari', key: 'safari18_0_ios', tag: 'iOS' },
  { name: 'Safari 17.2 iOS', family: 'safari', key: 'safari17_2_ios', tag: 'iOS' },
  { name: 'Firefox 133', family: 'firefox', key: 'firefox133', tag: 'New' },
];

const features = [
  {
    icon: '🔒',
    title: 'TLS Fingerprint Impersonation',
    description: 'Bypass bot detection by mimicking exact TLS ClientHello of real browsers — ciphers, extensions, curves, ALPS, and more.',
    color: 'blue',
  },
  {
    icon: '🌐',
    title: '23 Browser Profiles',
    description: 'Chrome, Safari, Firefox, Edge — including mobile variants and the latest versions with post-quantum key exchange.',
    color: 'cyan',
  },
  {
    icon: '⚡',
    title: 'HTTP/2 Fingerprinting',
    description: 'Full HTTP/2 SETTINGS, WINDOW_UPDATE, pseudo-header order, and stream weight impersonation. Matches Akamai H2 fingerprint.',
    color: 'purple',
  },
  {
    icon: '🍪',
    title: 'Session & Cookie Management',
    description: 'Persistent sessions with cookie jar, automatic redirect following, and connection pooling across requests.',
    color: 'green',
  },
  {
    icon: '🧩',
    title: 'Custom Fingerprint Builder',
    description: 'Go beyond presets — compose any TLS/HTTP2 fingerprint with 30+ low-level options. GREASE, extension ordering, and more.',
    color: 'orange',
  },
  {
    icon: '🛡️',
    title: 'Typed Error Handling',
    description: 'Specific error classes for timeout, connection, TLS, and DNS failures. Never catch generic errors again.',
    color: 'blue',
  },
];
---

<Layout title="curl-cffi-node — HTTP Client with Real Browser Fingerprints">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Background grid -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 60px, var(--color-text-secondary) 60px, var(--color-text-secondary) 61px), repeating-linear-gradient(90deg, transparent, transparent 60px, var(--color-text-secondary) 60px, var(--color-text-secondary) 61px);"></div>
    <!-- Gradient orbs -->
    <div class="absolute top-20 -left-40 w-96 h-96 bg-[var(--color-accent-blue)]/10 rounded-full blur-[120px]"></div>
    <div class="absolute top-40 -right-40 w-96 h-96 bg-[var(--color-accent-cyan)]/10 rounded-full blur-[120px]"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-24 pb-20 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-card)] text-sm text-[var(--color-text-secondary)] mb-8">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent-green)] pulse-glow"></span>
        v0.1.7 — 23 browser fingerprints
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6">
        HTTP client with<br/>
        <span class="gradient-text">real browser fingerprints</span>
      </h1>

      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto mb-10 leading-relaxed">
        Node.js HTTP client powered by <code class="text-[var(--color-accent-cyan)] text-base">curl-impersonate</code>. 
        Bypass Cloudflare, Akamai, and bot detection with genuine TLS & HTTP/2 fingerprints.
      </p>

      <!-- Install command -->
      <div class="inline-flex items-center gap-3 px-5 py-3 rounded-xl bg-[var(--color-bg-card)] border border-[var(--color-border)] glow-blue mb-10">
        <span class="text-[var(--color-text-muted)] select-none">$</span>
        <code class="text-[var(--color-accent-cyan)] font-mono font-medium">npm install curl-cffi-node</code>
        <button onclick="navigator.clipboard.writeText('npm install curl-cffi-node')" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors p-1 rounded" title="Copy">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16V4a2 2 0 012-2h12"/></svg>
        </button>
      </div>

      <!-- CTA buttons -->
      <div class="flex items-center justify-center gap-4">
        <a href="https://github.com/nicepkg/curl-cffi-node" target="_blank" class="px-6 py-3 rounded-xl bg-gradient-to-r from-[var(--color-accent-blue)] to-[var(--color-accent-cyan)] text-white font-semibold hover:opacity-90 transition-opacity">
          Get Started →
        </a>
        <a href="/fingerprint" class="px-6 py-3 rounded-xl border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)] transition-all font-medium">
          Fingerprint Tool
        </a>
      </div>
    </div>
  </section>

  <!-- Code Example -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <div>
        <h2 class="text-3xl font-bold mb-4">Dead simple API</h2>
        <p class="text-[var(--color-text-secondary)] mb-6 leading-relaxed">
          Just pick a browser and make requests. The library handles TLS ciphers, HTTP/2 settings, headers, and everything needed to look like a real browser.
        </p>
        <div class="space-y-3 text-sm">
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-[var(--color-accent-green)]/20 text-[var(--color-accent-green)] flex items-center justify-center text-xs mt-0.5">✓</span>
            <span class="text-[var(--color-text-secondary)]">Automatic JA3/JA4 fingerprint matching</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-[var(--color-accent-green)]/20 text-[var(--color-accent-green)] flex items-center justify-center text-xs mt-0.5">✓</span>
            <span class="text-[var(--color-text-secondary)]">HTTP/2 Akamai fingerprint impersonation</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-[var(--color-accent-green)]/20 text-[var(--color-accent-green)] flex items-center justify-center text-xs mt-0.5">✓</span>
            <span class="text-[var(--color-text-secondary)]">Session persistence with cookie jar</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-[var(--color-accent-green)]/20 text-[var(--color-accent-green)] flex items-center justify-center text-xs mt-0.5">✓</span>
            <span class="text-[var(--color-text-secondary)]">Post-quantum key exchange (X25519MLKEM768)</span>
          </div>
        </div>
      </div>
      <div class="rounded-xl overflow-hidden border border-[var(--color-border)] glow-blue">
        <div class="flex items-center gap-2 px-4 py-2.5 bg-[var(--color-bg-card)] border-b border-[var(--color-border)]">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
          </div>
          <span class="ml-2 text-xs text-[var(--color-text-muted)] font-mono">example.ts</span>
        </div>
        <pre class="!rounded-none !border-0 !m-0"><code class="text-sm leading-7"><span class="text-[var(--color-accent-purple)]">import</span> <span class="text-[var(--color-text-primary)]">{'{ Session }'}</span> <span class="text-[var(--color-accent-purple)]">from</span> <span class="text-[var(--color-accent-green)]">'curl-cffi-node'</span>;

<span class="text-[var(--color-text-muted)]">// Impersonate Chrome 131 — real TLS fingerprint</span>
<span class="text-[var(--color-accent-purple)]">const</span> <span class="text-[var(--color-accent-cyan)]">session</span> = <span class="text-[var(--color-accent-purple)]">new</span> <span class="text-[var(--color-accent-blue)]">Session</span>({'{'}<br/>  <span class="text-[var(--color-text-primary)]">impersonate</span>: <span class="text-[var(--color-accent-green)]">'chrome131'</span>,<br/>{'}'});

<span class="text-[var(--color-text-muted)]">// Make requests — Cloudflare sees a real browser</span>
<span class="text-[var(--color-accent-purple)]">const</span> <span class="text-[var(--color-accent-cyan)]">r</span> = <span class="text-[var(--color-accent-purple)]">await</span> session.<span class="text-[var(--color-accent-blue)]">get</span>(<span class="text-[var(--color-accent-green)]">'https://example.com'</span>);
console.<span class="text-[var(--color-accent-blue)]">log</span>(r.<span class="text-[var(--color-text-primary)]">status</span>); <span class="text-[var(--color-text-muted)]">// 200</span></code></pre>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold mb-3">Everything you need</h2>
      <p class="text-[var(--color-text-secondary)]">Full-featured browser impersonation toolkit for Node.js</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f) => (
        <div class="group p-6 rounded-xl bg-[var(--color-bg-card)] border border-[var(--color-border)] hover:border-[var(--color-border-highlight)] transition-all duration-300 hover:translate-y-[-2px]">
          <div class="text-3xl mb-4">{f.icon}</div>
          <h3 class="font-semibold text-lg mb-2 text-[var(--color-text-primary)]">{f.title}</h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Browser Support -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold mb-3">
        <span class="gradient-text-purple">23 Browser Fingerprints</span>
      </h2>
      <p class="text-[var(--color-text-secondary)]">Every major browser family — desktop, mobile, and iOS</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      {browsers.map((b) => (
        <div class="group flex items-center gap-2.5 px-3.5 py-2.5 rounded-lg bg-[var(--color-bg-card)] border border-[var(--color-border)] hover:border-[var(--color-border-highlight)] transition-all text-sm">
          <span class={`w-2 h-2 rounded-full ${b.family === 'chrome' ? 'bg-[var(--color-accent-blue)]' : b.family === 'safari' ? 'bg-[var(--color-accent-cyan)]' : b.family === 'firefox' ? 'bg-[var(--color-accent-orange)]' : 'bg-[var(--color-accent-purple)]'}`}></span>
          <span class="text-[var(--color-text-secondary)] group-hover:text-[var(--color-text-primary)] transition-colors truncate">{b.name}</span>
          {b.tag && (
            <span class={`ml-auto text-[10px] px-1.5 py-0.5 rounded font-medium ${b.tag === 'Latest' ? 'bg-[var(--color-accent-green)]/15 text-[var(--color-accent-green)]' : b.tag === 'New' ? 'bg-[var(--color-accent-orange)]/15 text-[var(--color-accent-orange)]' : 'bg-[var(--color-accent-purple)]/15 text-[var(--color-accent-purple)]'}`}>{b.tag}</span>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="relative rounded-2xl overflow-hidden p-12 text-center animated-border">
      <div class="absolute inset-0 bg-[var(--color-bg-card)]"></div>
      <div class="relative">
        <h2 class="text-3xl font-bold mb-4">Start impersonating browsers today</h2>
        <p class="text-[var(--color-text-secondary)] mb-8 max-w-lg mx-auto">
          Install curl-cffi-node and bypass bot detection in minutes. Open source, MIT licensed.
        </p>
        <div class="flex items-center justify-center gap-4">
          <a href="https://github.com/nicepkg/curl-cffi-node" target="_blank" class="px-6 py-3 rounded-xl bg-gradient-to-r from-[var(--color-accent-blue)] to-[var(--color-accent-cyan)] text-white font-semibold hover:opacity-90 transition-opacity">
            View on GitHub
          </a>
          <a href="/fingerprint" class="px-6 py-3 rounded-xl border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)] transition-all font-medium">
            Contribute Fingerprints →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
