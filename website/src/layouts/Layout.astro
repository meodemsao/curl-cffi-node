---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'HTTP client with real browser TLS fingerprints for Node.js' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 border-b border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 backdrop-blur-xl">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[var(--color-accent-blue)] to-[var(--color-accent-cyan)] flex items-center justify-center text-white font-bold text-sm">
            c
          </div>
          <span class="font-semibold text-[var(--color-text-primary)] text-lg">curl-cffi-node</span>
        </a>
        <div class="flex items-center gap-6">
          <a href="/fingerprint" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent-cyan)] transition-colors">
            Fingerprint Tool
          </a>
          <a href="https://github.com/nicepkg/curl-cffi-node" target="_blank" rel="noopener" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="https://www.npmjs.com/package/curl-cffi-node" target="_blank" rel="noopener" class="text-sm px-3.5 py-1.5 rounded-lg bg-[var(--color-accent-blue)] text-white hover:bg-[var(--color-accent-blue)]/80 transition-colors font-medium">
            npm
          </a>
        </div>
      </div>
    </nav>

    <!-- Content -->
    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-border)] py-8 mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-[var(--color-text-muted)]">
          MIT License · Built with <a href="https://astro.build" target="_blank" class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent-cyan)] transition-colors">Astro</a>
        </p>
        <div class="flex items-center gap-4 text-sm text-[var(--color-text-muted)]">
          <a href="https://github.com/nicepkg/curl-cffi-node" target="_blank" class="hover:text-[var(--color-text-secondary)] transition-colors">GitHub</a>
          <span>·</span>
          <a href="https://www.npmjs.com/package/curl-cffi-node" target="_blank" class="hover:text-[var(--color-text-secondary)] transition-colors">npm</a>
          <span>·</span>
          <a href="/fingerprint" class="hover:text-[var(--color-text-secondary)] transition-colors">Fingerprint Tool</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
